---
import Button from "./starwind/button/Button.astro";
import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from "./starwind/carousel";
import CtaButton from "./CtaButton.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Imported image assets for optimal Astro optimization (WebP/AVIF generation, CLS prevention)
import imgFisioterapi from "../assets/package/paket-fisioterapi-cedera.jpg";
import imgLulur from "../assets/package/paket-lulur-message-scrub.jpg";
import imgKerokan from "../assets/package/paket-massage-kerokan-kop.jpg";
import imgBekam from "../assets/package/paket-pijat-dan-bekam.png";
import imgTradisional from "../assets/package/paket-pijat-tradisional.jpg";
import imgRefleksi from "../assets/package/paket-refleksi-kaki.webp";
import imgTotokWajah from "../assets/package/paket-totok-massage-wajah.jpg";

// Service Packages Data Structure
interface PricingItem {
  duration: string;
  price: string;
}

interface ServicePackage {
  id: number;
  title: string;
  image: ImageMetadata;
  alt: string;
  pricing: PricingItem[];
}

const packageList: ServicePackage[] = [
  {
    id: 1,
    title: "Pijat Tradisional",
    image: imgTradisional,
    alt: "Pijat Tradisional",
    pricing: [
      { duration: "60 Menit", price: "Rp. 100.000" },
      { duration: "90 Menit", price: "Rp. 150.000" },
      { duration: "120 Menit", price: "Rp. 200.000" },
    ],
  },
  {
    id: 2,
    title: "Pijat Refleksi Kaki",
    image: imgRefleksi,
    alt: "Pijat Refleksi Kaki",
    pricing: [
      { duration: "60 Menit", price: "Rp. 100.000" },
      { duration: "90 Menit", price: "Rp. 150.000" },
      { duration: "120 Menit", price: "Rp. 200.000" },
    ],
  },
  {
    id: 3,
    title: "Body Massage dan Totok Wajah",
    image: imgTotokWajah,
    alt: "Body Massage dan Totok Wajah",
    pricing: [
      { duration: "90 Menit", price: "Rp. 170.000" },
      { duration: "120 Menit", price: "Rp. 220.000" },
    ],
  },
  {
    id: 4,
    title: "Massage dan Kerokan / Kop Tradisional",
    image: imgKerokan,
    alt: "Pijat Refleksi dan Kerokan Kop Tradisional",
    pricing: [
      { duration: "90 Menit", price: "Rp. 170.000" },
      { duration: "120 Menit", price: "Rp. 220.000" },
    ],
  },
  {
    id: 5,
    title: "Pijat Refleksi dan Lulur Scrub",
    image: imgLulur,
    alt: "Pijat Refleksi dan Lulur Scrub",
    pricing: [
      { duration: "90 Menit", price: "Rp. 180.000" },
      { duration: "120 Menit", price: "Rp. 230.000" },
    ],
  },
  {
    id: 6,
    title: "Pijat Refleksi dan Bekam Basah / Kering",
    image: imgBekam,
    alt: "Pijat Refleksi dan Bekam Basah Kering",
    pricing: [
      { duration: "90 Menit", price: "Rp. 185.000" },
      { duration: "120 Menit", price: "Rp. 235.000" },
    ],
  },
  {
    id: 7,
    title: "Pijat Fisioterapi Keseleo dan Reposisi",
    image: imgFisioterapi,
    alt: "Pijat Fisioterapi Keseleo dan Reposisi",
    pricing: [
      { duration: "60 Menit", price: "Rp. 150.000" },
      { duration: "90 Menit", price: "Rp. 200.000" },
      { duration: "120 Menit", price: "Rp. 250.000" },
    ],
  },
];
---

<>
  <section
    id="layanan"
    class="hidden sm:block relative py-4 overflow-hidden"
    aria-labelledby="paket-layanan-heading"
  >
    <!-- Background Ambient Glow Overlay -->
    <div class="absolute inset-0 pointer-events-none"></div>

    <!-- Header Section with Decorative Red Lines -->
    <div class="relative z-10 container mx-auto px-4 text-center mb-6 sm:mb-10 flex items-center justify-center gap-3">
      <div class="h-[2px] w-6 sm:w-20 bg-gradient-to-r from-transparent via-red-600 to-red-500 shadow-[0_0_10px_rgba(220,38,38,0.8)] shrink"></div>
      <h2
        id="paket-layanan-heading"
        class="font-oswald text-xl sm:text-3xl md:text-4xl font-black italic uppercase tracking-wider text-white drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)] text-center pr-2 sm:pr-3 py-0.5 inline-block shrink-0"
      >
        PAKET LAYANAN KAMI
      </h2>
      <div class="h-[2px] w-6 sm:w-20 bg-gradient-to-l from-transparent via-red-600 to-red-500 shadow-[0_0_10px_rgba(220,38,38,0.8)] shrink"></div>
    </div>

    <!-- Service Package Cards Carousel -->
    <div class="relative z-10 container mx-auto px-3 sm:px-10 lg:px-14">
      <Carousel
        id="service-packages-carousel"
        opts={{ align: "start", loop: true }}
        class="w-full max-w-full relative group/carousel"
      >
        <CarouselContent class="-ml-2.5 sm:-ml-3 w-full">
          {packageList.map((card) => (
            <CarouselItem class="pl-2.5 sm:pl-3 basis-[65%] xs:basis-[68%] sm:basis-1/2 md:basis-1/3 lg:basis-1/4 xl:basis-1/5 min-w-0 shrink-0">
              <article class="h-full relative rounded-xl sm:rounded-2xl bg-gradient-to-b from-red-950/90 via-black/95 to-red-950/90 border border-red-700/80 shadow-[0_0_20px_rgba(220,38,38,0.35)] hover:shadow-[0_0_30px_rgba(220,38,38,0.65)] hover:border-red-500 transition-all duration-300 flex flex-col justify-between overflow-hidden group w-full">
                <!-- Badge -->
                <div
                  class="absolute top-0 left-0 z-20 bg-gradient-to-br from-red-600 via-red-700 to-red-900 text-white font-black italic text-xs sm:text-sm px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-br-lg sm:rounded-br-xl border-r border-b border-red-500/80 shadow-[0_2px_8px_rgba(0,0,0,0.8)]"
                  aria-label={`Paket Layanan Nomor ${card.id}`}
                >
                  {card.id}
                </div>

                <!-- Image Area -->
                <div class="relative w-full aspect-[4/3] overflow-hidden bg-red-950/40 shrink-0">
                  <Image
                    src={card.image}
                    alt={card.alt}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/30 pointer-events-none"></div>
                </div>

                <!-- Package Title Banner -->
                <header class="bg-gradient-to-r from-red-950 via-red-900/90 to-red-950 border-y border-red-800/80 py-2 sm:py-2.5 px-2 text-center flex items-center justify-center min-h-[40px] sm:min-h-[44px]">
                  <h3 class="font-oswald text-xs sm:text-[13px] font-black uppercase tracking-wider text-white drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)] leading-tight">
                    {card.title}
                  </h3>
                </header>

                <!-- Pricing Rows -->
                <div class="p-2.5 sm:p-3 flex flex-col gap-1.5 flex-1 justify-center bg-black/60">
                  {card.pricing.map((item) => (
                    <div class="flex items-center justify-between text-[11px] sm:text-xs font-bold leading-tight border-b border-red-900/30 pb-1.5 last:border-none last:pb-0">
                      <span class="text-amber-100 font-bold tracking-tight">
                        {item.duration}
                      </span>
                      <span class="text-white font-bold tracking-tight">
                        {item.price}
                      </span>
                    </div>
                  ))}
                </div>
              </article>
            </CarouselItem>
          ))}
        </CarouselContent>

        <!-- Carousel Navigation Arrows with Starwind UI -->
        <CarouselPrevious class="hidden sm:flex -left-3 lg:-left-5 w-8 h-8 lg:w-10 lg:h-10 bg-black/80 hover:bg-red-900 border-red-600/80 text-white shadow-[0_0_15px_rgba(220,38,38,0.5)] transition-all z-20 cursor-pointer" />
        <CarouselNext class="hidden sm:flex -right-3 lg:-right-5 w-8 h-8 lg:w-10 lg:h-10 bg-black/80 hover:bg-red-900 border-red-600/80 text-white shadow-[0_0_15px_rgba(220,38,38,0.5)] transition-all z-20 cursor-pointer" />
      </Carousel>
    </div>

    <!-- Bottom Action Button (Mobile Full-Width Responsive) -->
    <div
      class={`container flex justify-center mt-6 sm:mt-10 px-2 sm:px-0 mx-auto w-full`}
    >
      <CtaButton href="#layanan" text="Lihat Selengkapnya" />
    </div>
  </section>

  <section
    id="layanan"
    class="block sm:hidden relative py-4 overflow-hidden"
    aria-labelledby="paket-layanan-heading"
  >
    <!-- Background Ambient Glow Overlay -->
    <div class="absolute inset-0 pointer-events-none"></div>

    <!-- Header Section with Decorative Red Lines -->
    <div class="relative z-10 container mx-auto px-4 text-center mb-6 sm:mb-10 flex items-center justify-center gap-3">
      <div class="h-[2px] w-6 sm:w-20 bg-gradient-to-r from-transparent via-red-600 to-red-500 shadow-[0_0_10px_rgba(220,38,38,0.8)] shrink"></div>
      <h2
        id="paket-layanan-heading"
        class="font-oswald text-xl sm:text-3xl md:text-4xl font-black italic uppercase tracking-wider text-white drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)] text-center pr-2 sm:pr-3 py-0.5 inline-block shrink-0"
      >
        PAKET LAYANAN KAMI
      </h2>
      <div class="h-[2px] w-6 sm:w-20 bg-gradient-to-l from-transparent via-red-600 to-red-500 shadow-[0_0_10px_rgba(220,38,38,0.8)] shrink"></div>
    </div>

    <!-- Service Package Cards list -->
    <div class="relative z-10 container flex flex-col gap-5 mx-auto px-3 sm:px-10 lg:px-14">
      {packageList.map((card) => (
        <div class="pl-2.5 sm:pl-3 basis-[65%] xs:basis-[68%] sm:basis-1/2 md:basis-1/3 lg:basis-1/4 xl:basis-1/5 min-w-0 shrink-0">
          <article class="flex flex-row rounded-xl sm:rounded-2xl bg-gradient-to-bl from-red-950/90 via-black/95 to-red-950/90 border border-red-700/80 shadow-[0_0_20px_rgba(220,38,38,0.35)] hover:shadow-[0_0_30px_rgba(220,38,38,0.65)] hover:border-red-500 transition-all duration-300 justify-between overflow-hidden group w-full items-stretch">
            <div class="relative w-28 xs:w-32 shrink-0 self-stretch rounded-tr-lg rounded-br-sm border border-red-700/80">
              <!-- Badge -->
              <div
                class="absolute top-0 left-0 z-20 bg-gradient-to-br from-red-600 via-red-700 to-red-900 text-white font-black italic text-xs sm:text-sm px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-br-lg sm:rounded-br-xl border-r border-b border-red-700/80 shadow-[0_2px_8px_rgba(0,0,0,0.8)]"
                aria-label={`Paket Layanan Nomor ${card.id}`}
              >
                {card.id}
              </div>

              <!-- Image Area (Full Height with Asymmetric Right Corners) -->
              <div class="relative w-full h-full overflow-hidden bg-red-950/40 rounded-tr-lg rounded-br-sm">
                <Image
                  src={card.image}
                  alt={card.alt}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/30 pointer-events-none"></div>
              </div>
            </div>

            <div class="flex flex-col flex-1 bg-gradient-to-tr from-red-950/90 via-red-900/70 to-red-950/90 border-y border-red-800/80 py-2 sm:py-2.5 px-4">
              <!-- Package Title Banner -->
              <header class="text-start ">
                <h3 class="font-oswald text-[16px] font-normal uppercase tracking-wide text-white drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)] leading-tight">
                  {card.title}
                </h3>
              </header>
              <!-- Pricing Rows -->
              <div class="p-2.5 sm:p-3 flex flex-col gap-1.5 flex-1 justify-center ">
                {card.pricing.map((item) => (
                  <div class="flex items-center justify-between text-[11px] sm:text-xs font-bold leading-tight border-b border-red-900/30 pb-1.5 last:border-none last:pb-0">
                    <span class="text-amber-100 font-bold tracking-tight">
                      {item.duration}
                    </span>
                    <span class="text-white font-bold tracking-tight">
                      {item.price}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </article>
        </div>
      ))}
    </div>

    <!-- Bottom Action Button (Mobile Full-Width Responsive) -->
    <div
      class={`container flex justify-center mt-6 sm:mt-10 px-2 sm:px-0 mx-auto w-full`}
    >
      <CtaButton href="#layanan" text="Lihat Selengkapnya" />
    </div>
  </section>
</>
