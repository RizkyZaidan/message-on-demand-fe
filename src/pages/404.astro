---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404: Page was not found.">
  <Header />
  <div class="flex flex-col items-center justify-center px-10 bg-transparent h-[90vh] md:flex-row md:space-x-6">
    <div class="space-x-2">
      <h1 class="text-6xl font-bold text-gray-900 dark:text-gray-100 md:text-8xl md:border-r-2 md:px-6">
        404
      </h1>
    </div>
    <div class="max-w-md">
      <p class="mb-4 text-xl font-bold leading-normal md:text-2xl">
        There was an error finding your page.
      </p>
      <p class="max-w-sm mb-8 text-md">
        Message on Demand doesn't do well with generic 404 pages. Hence: this
        page. If you're here from clicking demo: it was on purpose!
      </p>
      <a
        href="/"
        class="px-4 py-2.5 text-black dark:text-white border dark:hover:bg-white dark:hover:text-black rounded-lg shadow transition duration-300 hover:shadow-md"
      >
        Return Home
      </a>
    </div>
  </div>
  <Footer />
</Layout>
