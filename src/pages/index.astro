---
import BookingQuickBar from "@/components/BookingQuickBar.astro";
import BookingStep from "@/components/BookingStep.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import ServiceArea from "@/components/ServiceArea.astro";
import ServicePackages from "@/components/ServicePackages.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Message on Demand"
  description="Layanan pijat dan refleksi profesional siap datang langsung ke rumah atau hotel Anda."
  canonical="https://message-on-demand.vercel.app/"
>
  <Header />
  <Hero />
  <BookingQuickBar />
  <ServicePackages />
  <section
    class="relative z-30 container mx-auto px-4 sm:px-6 lg:px-8 my-6 flex flex-col lg:flex-row items-stretch gap-3 sm:gap-4"
    aria-labelledby="cara-booking-title"
  >
    <div class="flex-1 flex flex-col">
      <BookingStep />
    </div>
    <div class="flex flex-col">
      <ServiceArea />
    </div>
  </section>
  <Footer />
</Layout>
